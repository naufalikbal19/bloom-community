{
  "name": "bloom-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Bloom Community — CEF UI (Svelte 4 + Vite + TypeScript). Girlies kawaii pastel.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview --host",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@tsconfig/svelte": "^5.0.4",
    "svelte": "^4.2.19",
    "svelte-check": "^3.8.6",
    "tslib": "^2.8.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
